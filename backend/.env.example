# Required: Gemini embeddings and PDF-to-JSON conversion.
GEMINI_API_KEY=

# Optional overrides (defaults shown).
# EMBEDDING_MODEL=models/gemini-embedding-001
# DATA_DIR=./data
# MAX_UPLOAD_BYTES=52428800
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# GEMINI_MODEL=gemini-2.5-flash
# GENERATION_TIMEOUT_SECONDS=120
# MAX_MATERIAL_PDF_BYTES=20971520
# OCR_ENABLED=true
# OCR_PAGES_PER_REQUEST=10
# OCR_MAX_PAGES=300
# MAX_MATERIAL_CHARS=400000
# RAG_TOP_K=8
# MAX_TEXTBOOK_CHARS=30000
# MISTAKE_REVIEW_LIMIT=20
# QUESTIONS_PER_QUIZ=20
# QUIZ_LANGUAGE=English
# CORS_ORIGINS=["http://localhost:5173", "null"]
