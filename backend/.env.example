# Required: Gemini quiz generation and OCR of scanned PDFs (text PDFs are read locally, no model).
GEMINI_API_KEY=

# Optional overrides (defaults shown).
# DATA_DIR=./data
# GEMINI_MODEL=gemini-2.5-flash
# GENERATION_TIMEOUT_SECONDS=120
# MAX_MATERIAL_PDF_BYTES=20971520
# OCR_ENABLED=true
# OCR_PAGES_PER_REQUEST=10
# OCR_MAX_PAGES=300
# MAX_MATERIAL_CHARS=400000
# MISTAKE_REVIEW_LIMIT=20
# QUESTIONS_PER_QUIZ=20
# QUIZ_LANGUAGE=English
# CORS_ORIGINS=["http://localhost:5173", "null"]
